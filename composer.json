{
    "name": "bitforge/thorm-app",
    "description": "Application skeleton for Thorm",
    "type": "project",
    "license": "MIT",
    "require": {
        "bitforge/thorm": "^0.1@alpha",
        "twbs/bootstrap": "6.0.0-alpha.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Thorm\\Components\\Editor\\": "editor/src/php/",
            "Thorm\\Components\\Editor\\Widgets\\": "editor/src/php/widgets/",
            "Thorm\\Components\\Editor\\Examples\\": "examples/editor/"
        },
        "files": [
            "editor/src/php/IRToThorm.php"
        ]
    },
    "minimum-stability": "alpha",
    "prefer-stable": true
}
